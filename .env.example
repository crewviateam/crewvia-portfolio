# ─────────────────────────────────────────────────────────────────────────────
# CREWVIA Portfolio — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase (Portfolio — public, build-time reads) ─────────────────────────
# Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Supabase Service Role (Server-side ONLY — Vercel Edge Functions) ─────────
# NEVER prefix with VITE_ — this key must never reach the browser.
# Used only by api/track.ts and api/redeploy.ts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Vercel Deploy Hook (for auto-rebuild on content change) ──────────────────
# Get from: Vercel Dashboard → Project → Settings → Git → Deploy Hooks
# Create a hook named "cms-content-update" on the main branch.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# ─────────────────────────────────────────────────────────────────────────────
# CREWVIA Admin Dashboard — Environment Variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (same project as the portfolio) ──────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Admin Password Gate ────────────────────────────────────────────────────────
# A simple secondary password to protect the admin login screen.
# The main security layer is Supabase Auth (email + password for your admin account).
VITE_ADMIN_GATE_PASSWORD=crewvia-admin-2024

# ── Portfolio Redeploy Webhook ─────────────────────────────────────────────────
# After saving content changes, the admin calls this to trigger a Vercel rebuild.
# Get from: Vercel Dashboard → Project → Settings → Git → Deploy Hooks
VITE_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
